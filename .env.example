# Nothing here is required: `docker compose up -d` works as-is. To change a
# setting, copy this file to .env and uncomment the lines you want. Every
# line shows the default. An empty value is a value (`SYNC_AT=` is not the
# default), so delete a line rather than blanking it.
#
# Settings marked [admin] can also be changed in Settings → Server admin →
# Settings. A variable set here wins over what is saved there, and the screen
# shows it as set by the environment. docs/configuration.md says more about
# each one.
#
# The database password, SECRET_KEY and the Camoufox websocket path are
# generated on the first start and kept in ./data/secrets.

# ---- The stack (read by docker compose) -------------------------------------

# The application image, without a tag; Camoufox is the same name with
# -camoufox appended.
# AGENTIFI_IMAGE=ghcr.io/cornhead764/agentifi
# A version or commit sha; pins both images.
# AGENTIFI_TAG=latest
# The host port the app is published on.
# AGENTIFI_PORT=8100
# The database role and name, created only when ./data/postgres is empty.
# POSTGRES_USER=agentifi
# POSTGRES_DB=agentifi
# Prefixes the browser-profiles volume; set it to the old directory's name
# after moving this one.
# COMPOSE_PROJECT_NAME=

# Your time zone, for example America/New_York. The daily sync and the
# nightly backup run in it, and the Camoufox browser reports it to the sites
# it signs in to: some providers refuse a sign-in from a browser that claims
# UTC. Read when the server starts.
# TZ=UTC

# [admin] The address a browser reaches the app on, scheme and port included.
# Links back into the app and single sign-on use it; the app itself works on
# any address that reaches the server. Set it to the https:// address when
# there is a reverse proxy in front. The compose file always passes it, so
# under compose it is always set by the environment.
# FRONTEND_URL=http://localhost:8100

# ---- Secrets ----------------------------------------------------------------
# Generated when unset, or read from a file of the same name in
# ./data/secrets. Never shown in the app.

# POSTGRES_PASSWORD=
# Signs session tokens; at least 32 characters. Changing it signs everyone out.
# SECRET_KEY=
# Seals stored credentials; empty derives it from SECRET_KEY. Read
# docs/operations.md#secrets before changing either.
# CREDENTIAL_ENCRYPTION_KEY=
# The Camoufox server's websocket path, at least 24 characters.
# CAMOUFOX_WS_PATH=
# Foreign-exchange rates (openexchangerates.org); unset makes no calls.
# OPENEXCHANGERATES_APP_ID=
# OIDC_CLIENT_SECRET=
# SMTP_PASSWORD=
# Web push; both halves of the VAPID keypair or neither.
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=

# ---- Banks and sync ---------------------------------------------------------

# [admin] SimpleFIN, the only bank aggregator. Off until turned on: set this to
# true, or press Turn on SimpleFIN on Settings, Accounts, to connect banks and
# import their transactions automatically.
# SIMPLEFIN_ENABLED=false
# [admin] The daily bank sync and connector pulls; a sync on request works either way.
# SYNC_ENABLED=true
# [admin] When the daily sync runs, HH:MM in TZ.
# SYNC_AT=04:00
# [admin] How often the scheduler looks for due work, in minutes.
# SYNC_CHECK_MINUTES=5

# ---- Features ---------------------------------------------------------------

# [admin] The portfolio's news carousel.
# INVESTMENT_NEWS_ENABLED=true
# [admin] The manual market price refresh.
# MARKET_PRICES_ENABLED=true
# [admin] Look Costco item numbers up once each, so receipt lines read as
# products. Nothing is looked up until the three store settings name a
# warehouse on Costco's same-day storefront; there is no default one.
# MERCHANT_CATALOG_ENABLED=true
# COSTCO_CATALOG_SHOP_ID=
# COSTCO_CATALOG_ZONE_ID=
# COSTCO_CATALOG_POSTAL_CODE=
# The reporting currency a new space starts with.
# PRIMARY_CURRENCY=USD
# [admin] The currencies a space may report in, comma-separated.
# SUPPORTED_CURRENCIES=USD,EUR,GBP,CAD,AUD,CHF,JPY,MXN,BRL,INR,SEK,DKK,NOK,PLN,CZK,NZD

# ---- Backups ----------------------------------------------------------------
# Server admin → Backups edits these, and what it saves wins over them.

# The nightly set's time, HH:MM in TZ.
# BACKUP_AT=03:30
# Days of sets to keep; the newest intact set is always kept.
# BACKUP_KEEP_DAYS=14
# Age public keys (age1…) to encrypt the sets to, comma-separated.
# BACKUP_RECIPIENTS=
# The passphrase of an SSH private key given to `agentifi restore`.
# BACKUP_IDENTITY_PASSPHRASE=

# ---- Sign-in ----------------------------------------------------------------

# [admin] Session lifetime in minutes.
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# [admin] Password attempts per address per window, and the window in seconds.
# LOGIN_MAX_ATTEMPTS=20
# LOGIN_ATTEMPT_WINDOW_SECONDS=300
# [admin] Reverse proxies whose X-Forwarded-For is believed, as CIDRs,
# comma-separated. Empty trusts none.
# TRUSTED_PROXY_CIDRS=
# [admin] Passkeys. An empty ID and origin follow the browser's origin.
# WEBAUTHN_RP_NAME=Agentifi
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=

# Single sign-on. Server admin → Single sign-on edits these, and what it saves
# wins over them.
# OIDC_ENABLED=false
# OIDC_PROVIDER_NAME=OIDC
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_SCOPES=openid email profile
# Empty is FRONTEND_URL/auth/oidc/callback.
# OIDC_REDIRECT_URI=
# OIDC_AUTO_REGISTER=false
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# OIDC_LINK_EXISTING_EMAIL=false

# ---- Email and push ---------------------------------------------------------

# [admin] The mail server for alerts; empty leaves email off.
# SMTP_HOST=
# [admin] 465 is implicit TLS, detected from the port.
# SMTP_PORT=587
# [admin] A LAN relay commonly wants no user name.
# SMTP_USERNAME=
# [admin] The sender; empty uses the user name when that is an address.
# SMTP_FROM=
# [admin] STARTTLS for ports 587 and 25.
# SMTP_STARTTLS=true
# [admin] A mailto: address the push services can reach you at.
# VAPID_SUBJECT=mailto:admin@example.com

# ---- The bill mailbox -------------------------------------------------------

# [admin] How often the watched mailbox is read, in minutes.
# EMAIL_POLL_MINUTES=30
# [admin] How far back its first read goes, in days.
# EMAIL_LOOKBACK_DAYS=30
# [admin] Addresses an SMS-to-email forwarder sends relayed codes from,
# comma-separated.
# EMAIL_OTP_RELAYS=
# [admin] Addresses beyond the mailbox's own domain whose forwarded mail is
# read as the original, comma-separated.
# EMAIL_FORWARDERS=

# ---- The assistant ----------------------------------------------------------

# [admin] Hosts a space's assistant may point at, comma-separated; empty is
# unrestricted.
# ASSISTANT_ALLOWED_HOSTS=
# [admin] Automation runs at once.
# AUTOMATION_WORKERS=1

# ---- Internals --------------------------------------------------------------

# The database connection pool's cap.
# DATABASE_MAX_CONNS=10
# Show Chrome's window, on a workstation with a display.
# AGENTIFI_BROWSER_HEADFUL=false
# The Google Chrome the connectors launch, where the chrome service installs
# it from Google (docs/operations.md, "The browsers").
# AGENTIFI_CHROME_PATH=/chrome/current/chrome
# Where secret files are read from, colon-separated.
# CREDENTIALS_DIRECTORY=/run/secrets

# Set by the compose file or the image; a value here is ignored or breaks the
# stack. Listed so this file names everything the binary reads.
#   DATABASE_URL, CAMOUFOX_URL   built from the secrets above
#   DEBUG=false                  forced off; true accepts a weak SECRET_KEY
#   HTTP_ADDR=:8000              change AGENTIFI_PORT instead
#   BACKUP_DIR=/backups          move the ./backups mount instead
#   AGENT_PROFILES_DIR=/profiles the browser-profiles volume
#   STORAGE_PATH=/data/attachments
#   PLAYWRIGHT_DRIVER_PATH
