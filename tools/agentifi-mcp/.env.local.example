# Copy to .env.local (gitignored) and fill in. Anything already exported in the
# shell wins over this file, so a one-off run can point somewhere else without
# editing it.
AGENTIFI_BASE_URL=http://localhost:8000
AGENTIFI_EMAIL=you@example.com
AGENTIFI_PASSWORD=
# Optional. Without it the first space this account belongs to is used, which
# is right for one household and worth being explicit about for more than one.
AGENTIFI_SPACE=
AGENTIFI_TOKEN=
